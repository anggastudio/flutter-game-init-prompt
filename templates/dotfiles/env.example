# ---------------------------------------------------------------------------
# Runtime configuration
#
# Copy this file to `.env` and fill in the real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and is bundled into the app as a Flutter asset, so treat
# every value here as client-visible. Never put a server secret in this file:
# publishable ad unit IDs, RevenueCat *public* SDK keys, and the Sentry DSN are
# all designed to ship inside a mobile binary, but a Play service account JSON
# or a signing key is not. Those live in `__secrets/` instead.
#
# After editing any ADMOB_APP_ID_* value, run:
#
#     dart run tool/sync_env.dart
#
# That regenerates `ios/Flutter/Env.xcconfig`. Android reads `.env` directly at
# Gradle configuration time, so it needs no extra step.
# ---------------------------------------------------------------------------


# ===========================================================================
# App environment
# ===========================================================================

# One of: dev | staging | prod
# Tags Sentry events and decides whether debug-only affordances are shown.
APP_ENV=dev


# ===========================================================================
# Sentry
# ===========================================================================

# Project DSN from Sentry > Settings > Projects > (project) > Client Keys.
# Leave empty to disable Sentry entirely; the app runs fine without it.
SENTRY_DSN=

# Fraction of transactions sampled for performance monitoring, 0.0 to 1.0.
# Keep this low in production; 1.0 sends every transaction.
SENTRY_TRACES_SAMPLE_RATE=0.2

# Fraction of sessions replayed on error, 0.0 to 1.0. Replay is expensive in
# both quota and bandwidth; leave it off until there is a crash worth watching.
SENTRY_REPLAY_SAMPLE_RATE=0.0

# Send stack traces for handled errors too, not just crashes.
SENTRY_ATTACH_STACKTRACE=true


# ===========================================================================
# Google AdMob
#
# Find these in AdMob > Apps > (app) > App settings (App ID) and
# AdMob > Apps > (app) > Ad units (individual unit IDs).
#
# The values below are Google's official TEST IDs. They are safe to ship in a
# debug build and will serve real-looking test ads. Replace them with your own
# before a production release, or your account can be flagged for invalid
# traffic.
#
# Note the punctuation: app IDs use `~`, ad units use `/`.
# ===========================================================================

# App-level ID. Goes into AndroidManifest.xml / Info.plist at build time.
ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511

# Anchored adaptive banner, shown on menu screens only.
ADMOB_BANNER_ANDROID=ca-app-pub-3940256099942544/6300978111
ADMOB_BANNER_IOS=ca-app-pub-3940256099942544/2934735716

# Interstitial, shown between runs only. Leave the interval at 0 to disable.
ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-3940256099942544/1033173712
ADMOB_INTERSTITIAL_IOS=ca-app-pub-3940256099942544/4411468910

# Rewarded ad the player opts into for a revive or a bonus.
ADMOB_REWARDED_ANDROID=ca-app-pub-3940256099942544/5224354917
ADMOB_REWARDED_IOS=ca-app-pub-3940256099942544/1712485313

# When true, the SDK is put into test-device mode and only ever serves test
# ads regardless of the unit IDs above. Set to false for release builds.
ADS_TEST_MODE=true

# Comma-separated AdMob test device hashes. Find yours in logcat / Xcode
# console after the first ad request ("Use RequestConfiguration.Builder...").
# Leave empty if you have none.
ADS_TEST_DEVICE_IDS=

# Seconds to wait before the banner is allowed to appear on a fresh install,
# so a first-time player is not hit with an ad immediately.
ADS_BANNER_DELAY_SECONDS=0

# Minimum runs between interstitials. 0 disables interstitials entirely.
ADS_INTERSTITIAL_RUN_INTERVAL=3


# ===========================================================================
# RevenueCat
#
# Find these in RevenueCat > Project settings > API keys. Use the PUBLIC SDK
# key for each platform (starts with `goog_` for Android, `appl_` for iOS).
# Never put the secret key here.
# ===========================================================================

REVENUECAT_API_KEY_ANDROID=
REVENUECAT_API_KEY_IOS=

# Identifier of the offering to display in the store. `default` uses whichever
# offering is marked current in the RevenueCat dashboard, which is what you
# want unless you are A/B testing.
REVENUECAT_OFFERING_ID=default

# Entitlement identifiers, as configured under RevenueCat > Entitlements.
# The app looks these up by name, so they must match the dashboard exactly.
# Changing a product's price or description needs no code change; only these
# identifiers are hardcoded to a behaviour.

# Hides banners and interstitials. The rewarded ad stays available as an opt-in.
RC_ENTITLEMENT_REMOVE_ADS=remove_ads

# Unlocks the alternate colour palettes.
RC_ENTITLEMENT_SKINS=skins


# ===========================================================================
# Gameplay tuning
#
# These are knobs, not secrets. They live here so you can retune the economy
# without shipping a new build during a test cycle.
# ===========================================================================

# How many times per run the player may revive by watching a rewarded ad.
MAX_AD_REVIVES_PER_RUN=1

# Seconds of invincibility granted immediately after a revive, so the player
# is not instantly killed by whatever they crashed into.
REVIVE_INVINCIBILITY_SECONDS=3
