# Generated from .env by tool/sync_env.dart.
/ios/Flutter/Env.xcconfig

# Runtime config (a copy of .env.example with real values). Match every .env
# variant: `/.env` alone would leave .env.local, .env.production and friends
# committable.
.env
.env.*
!.env.example
